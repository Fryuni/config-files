  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "description": "Current charge level. This is independent of battery wear: 100% charge may still hold much less energy than a new battery. Current value uses only source samples received within two minutes; missing telemetry is unavailable. Historical charts use the selected time range separately.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 15
              },
              {
                "color": "green",
                "value": 30
              }
            ]
          },
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "noValue": "Unavailable"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "(node_power_supply_capacity{host=~\"$host\",power_supply=~\"BAT.*\"} and (time() - timestamp(node_power_supply_capacity{host=~\"$host\",power_supply=~\"BAT.*\"}) < 120))",
          "legendFormat": "{{host}} · {{power_supply}}",
          "range": false,
          "refId": "A",
          "instant": true
        }
      ],
      "title": "Battery charge",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "description": "Learned full-charge capacity divided by design capacity. A persistent value below 60% suggests substantial wear or an inaccurate battery calibration. Current value uses only source samples received within two minutes; missing telemetry is unavailable. Historical charts use the selected time range separately.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 60
              },
              {
                "color": "green",
                "value": 80
              }
            ]
          },
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "noValue": "Unavailable"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "100 * (node_power_supply_charge_full{host=~\"$host\",power_supply=~\"BAT.*\"} and (time() - timestamp(node_power_supply_charge_full{host=~\"$host\",power_supply=~\"BAT.*\"}) < 120)) / (node_power_supply_charge_full_design{host=~\"$host\",power_supply=~\"BAT.*\"} and (time() - timestamp(node_power_supply_charge_full_design{host=~\"$host\",power_supply=~\"BAT.*\"}) < 120))",
          "legendFormat": "{{host}} · {{power_supply}}",
          "range": false,
          "refId": "A",
          "instant": true
        }
      ],
      "title": "Battery health",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
